# Postgres connection string. Locally, point this at your own Postgres
# instance (or the "External Database URL" from your Render Postgres for
# convenience). In Render, set this as an environment variable on the web
# service — use the "Internal Database URL" there for lower latency.
DATABASE_URL="postgresql://user:password@host:5432/rfp_hub"

# Email notifications (invitations, approvals, status changes, responses).
# With SMTP_HOST unset nothing is sent — messages are only logged — so local
# dev can't email real people by accident. In Render, set these on the web
# service. MAIL_REDIRECT_TO sends every message to that one address instead
# (use it to test against real data); APP_URL is the public base URL used
# for the links inside the emails.
APP_URL="https://your-app.onrender.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="RFP Hub <no-reply@example.com>"
# MAIL_REDIRECT_TO="you@example.com"
