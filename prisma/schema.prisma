// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RfpStatus {
  DRAFT
  PENDING_PUBLISH_APPROVAL
  AWAITING_START // ya aprobada/publicada, pero su fecha y hora de inicio todavía no llegó — los proveedores no ven la invitación hasta entonces
  OPEN
  CLOSED
  DELETED
}

enum ApproverMode {
  USERS
  GROUP
}

enum ApprovalStageKind {
  PUBLISH
  AWARD
}

enum RfpApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  TEXT
  NUMBER
  SELECT
  MONEY
  ATTACHMENT
  YES_NO
  INFO // bloque de texto informativo, sin respuesta (ni del proveedor ni del comprador)
}

enum QuestionResponder {
  SUPPLIER // el proveedor la responde (default)
  BUYER // el comprador la responde directamente, nunca se envía al proveedor
}

enum TemplatePriceCondition {
  GREATER_THAN // matchPriceMin: precio estimado > matchPriceMin
  LESS_THAN // matchPriceMax: precio estimado < matchPriceMax
  BETWEEN // matchPriceMin <= precio estimado <= matchPriceMax
}

enum InvitationStatus {
  INVITED
  VIEWED
  RESPONDED
}

enum QuestionVisibility {
  INTERNAL // solo la ve el comprador; nunca se envía al proveedor
  SUPPLIER_ONLY // se envía y el proveedor la responde, pero la respuesta no aparece en el detalle/comparación del comprador
  EXTERNAL // visible para ambos; se usa en comparación y puntaje (default)
}

// BUYER < SENIOR_BUYER < CLIENT_ADMIN < ADMIN (ver ROLE_LEVEL en
// src/lib/roleLabels.ts). ADMIN es el único rol sin Cliente asignado (ve y
// administra todos los clientes); CLIENT_ADMIN administra datos maestros,
// plantillas y usuarios, pero solo dentro de su propio Cliente. APPROVER
// queda fuera de esa escalera (no crea RFPs, solo ve y decide las que
// tiene asignadas como aprobador).
enum UserRole {
  APPROVER
  BUYER
  SENIOR_BUYER
  CLIENT_ADMIN
  ADMIN
}

// Un cliente de la plataforma (empresa que usa esta instancia para sus
// propios procesos de compra). Es la raíz de todo el aislamiento
// multi-tenant: cada dato maestro, plantilla y RFP pertenece a exactamente
// un Cliente, y un usuario (salvo ADMIN) solo ve los datos de su Cliente.
model Client {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  icon        String? // emoji mostrado junto al nombre del cliente en la barra superior
  currency    String   @default("USD") // moneda en la que se muestran los precios de las RFPs de este cliente, sin importar la preferencia personal de quien las mira
  createdAt   DateTime @default(now())

  users                  User[]
  commodities            Commodity[]
  regions                Region[]
  origins                Origin[]
  approvalGroups         ApprovalGroup[]
  supplierDirectories    SupplierDirectory[]
  supplierUserLinks      SupplierUserLink[]
  itemCatalogLists       ItemCatalogList[]
  itemCatalogEntries     ItemCatalogEntry[]
  templates              RfpTemplate[]
  approvalWorkflows      ApprovalWorkflow[]
  approvalLevels         ApprovalLevel[]
  templateItems          TemplateItem[]
  templateQuestions      TemplateQuestion[]
  rfps                   Rfp[]
  rfpApprovals           RfpApproval[]
  rfpApprovalDecisions   RfpApprovalDecision[]
  rfpItems               RfpItem[]
  rfpQuestions           RfpQuestion[]
  suppliers              Supplier[]
  invitations            Invitation[]
  responses              Response[]
  answers                Answer[]
  itemPrices             ItemPrice[]
  userApprovalGroups     UserApprovalGroup[]
  emailTemplates         EmailTemplate[]
  emailLogs              EmailLog[]
  buyerGroups            BuyerGroup[]
  requestImportTemplates RequestImportTemplate[]
  purchaseRequests       PurchaseRequest[]
  requestRfpMapping      RequestRfpMapping?
}

model User {
  id                 String    @id @default(cuid())
  name               String // Nombre
  lastName           String? // Apellido
  clientId           String? // null solo para ADMIN (ve todos los clientes)
  client             Client?   @relation(fields: [clientId], references: [id])
  email              String    @unique // Correo
  companyCode        String? // Sociedad
  plant              String? // Centro
  costCenter         String? // Centro de coste
  passwordHash       String
  role               UserRole  @default(BUYER)
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime? // fecha y hora del login más reciente, mostrado en el pie de página
  allowFreeTextItems Boolean   @default(true) // si puede agregar artículos escribiendo la descripción libremente, o solo desde el catálogo
  timezone           String    @default("America/Mexico_City") // zona horaria IANA usada para registrar y mostrar fechas
  currency           String    @default("USD") // moneda usada para formatear montos (solo formato, no conversión)
  language           String    @default("es") // idioma de la interfaz ("es" o "en")
  theme              String    @default("violet") // color principal de la interfaz
  colorMode          String    @default("light") // "light", "dark" o "system"

  // Permisos del módulo de Solicitudes (los administradores tienen todo implícito)
  canImportRequests     Boolean @default(false) // puede importar solicitudes
  canAssignRequests     Boolean @default(false) // puede asignar solicitudes a un comprador o grupo
  seeUnassignedRequests Boolean @default(false) // ve solicitudes sin asignar
  seeMyRequests         Boolean @default(false) // ve las asignadas a su usuario (directo o por grupo)
  seeAssignedRequests   Boolean @default(false) // ve las asignadas a cualquier usuario
  seeAllRequests        Boolean @default(false) // ve todas

  approvalGroups        UserApprovalGroup[]
  buyerGroupMemberships BuyerGroupMember[]
  assignedRequests      PurchaseRequest[]   @relation("RequestAssignee")
  importedRequests      PurchaseRequest[]   @relation("RequestImporter")

  createdRfps       Rfp[]
  approvalDecisions RfpApprovalDecision[]
}

// Un usuario puede pertenecer a varios grupos de aprobación a la vez, cada
// uno con su propio límite (ej. Carla: "Aprobador IT" hasta 100000 y
// "Aprobador Compras" hasta 999999). El límite es específico al par
// usuario+grupo, no un valor único por usuario.
model UserApprovalGroup {
  id              String @id @default(cuid())
  clientId        String
  client          Client @relation(fields: [clientId], references: [id])
  userId          String
  approvalGroupId String
  limit           Float

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalGroup ApprovalGroup @relation(fields: [approvalGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, approvalGroupId])
}

// Datos maestros: los valores permitidos para los desplegables de Commodity
// y Región en las RFPs y plantillas. code es un identificador único de
// negocio dentro de su Cliente (no el cuid interno); description es la
// etiqueta visible. parentId permite organizarlos en árbol (categoría >
// subcategoría), siempre dentro del mismo Cliente.
model Commodity {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  code        String
  description String
  parentId    String?
  parent      Commodity?  @relation("CommodityTree", fields: [parentId], references: [id])
  children    Commodity[] @relation("CommodityTree")
  selectable  Boolean     @default(true) // si se puede elegir este nivel en una RFP/plantilla, o es solo un nodo de agrupación
  createdAt   DateTime    @default(now())

  @@unique([clientId, code])
}

model Region {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  code        String
  description String
  parentId    String?
  parent      Region?  @relation("RegionTree", fields: [parentId], references: [id])
  children    Region[] @relation("RegionTree")
  createdAt   DateTime @default(now())

  @@unique([clientId, code])
}

// Lista de opciones para el campo "Origen" de la cabecera de RFP (no
// visible para el proveedor). Mismo shape que Commodity/Region para
// reutilizar el editor de datos maestros.
model Origin {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  code        String
  description String
  parentId    String?
  parent      Origin?  @relation("OriginTree", fields: [parentId], references: [id])
  children    Origin[] @relation("OriginTree")
  createdAt   DateTime @default(now())

  @@unique([clientId, code])
}

// Grupo de aprobación (ej. "Aprobador IT"): datos maestros, mismo shape que
// Commodity/Region/Origin para reutilizar el editor genérico. Los usuarios
// se asignan a un grupo (y a otros) con un límite propio por par vía
// UserApprovalGroup.
model ApprovalGroup {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  code        String
  description String
  parentId    String?
  parent      ApprovalGroup?  @relation("ApprovalGroupTree", fields: [parentId], references: [id])
  children    ApprovalGroup[] @relation("ApprovalGroupTree")
  createdAt   DateTime        @default(now())

  members UserApprovalGroup[]
  levels  ApprovalLevel[]

  @@unique([clientId, code])
}

enum SupplierDirectoryStatus {
  ACTIVE
  INACTIVE
}

// Directorio maestro de proveedores (distinto del Supplier ad-hoc que se
// crea al invitar a alguien a una RFP puntual). Cada Cliente mantiene su
// propio directorio.
model SupplierDirectory {
  id               String                  @id @default(cuid())
  clientId         String
  client           Client                  @relation(fields: [clientId], references: [id])
  code             String // Código Proveedor
  taxId            String // CIF
  companyName      String // nombre de la empresa
  contactFirstName String
  contactLastName  String
  email            String
  phone            String
  status           SupplierDirectoryStatus @default(ACTIVE)
  createdAt        DateTime                @default(now())

  userLinks SupplierUserLink[]
  suppliers Supplier[]

  @@unique([clientId, code])
}

// Cuenta de portal de una persona de un proveedor (correo único + contraseña).
// Una misma persona usa la misma cuenta para todos los clientes que la invitan:
// a qué proveedor/cliente está asociada vive en SupplierUserLink. La contraseña
// queda vacía hasta que acepta la primera invitación.
// clientId / supplierDirectoryId son restos de la versión anterior (una cuenta
// pertenecía a un solo proveedor); ya no se usan y se eliminarán más adelante.
model SupplierUser {
  id                  String             @id @default(cuid())
  clientId            String?
  supplierDirectoryId String?
  name                String
  lastName            String
  email               String             @unique
  passwordHash        String?
  createdAt           DateTime           @default(now())
  lastLoginAt         DateTime? // fecha y hora del login más reciente, mostrado en el pie de página
  timezone            String             @default("America/Mexico_City") // zona horaria IANA usada para registrar y mostrar fechas
  currency            String             @default("USD") // moneda usada para formatear montos (solo formato, no conversión)
  language            String             @default("es") // idioma de la interfaz ("es" o "en")
  theme               String             @default("violet") // color principal de la interfaz
  colorMode           String             @default("light") // "light", "dark" o "system"
  links               SupplierUserLink[]
}

enum SupplierLinkStatus {
  PENDING_APPROVAL // el proveedor tiene un administrador que debe aprobar el nuevo contacto
  SENT // invitación enviada, falta que la persona la acepte
  ACCEPTED // la persona aceptó: queda conectada a ese cliente/proveedor
}

// Une una cuenta de proveedor con una ficha del directorio de un cliente (que
// ya pertenece a un cliente). Solo los vínculos ACCEPTED dan acceso a las RFP
// de ese cliente y permiten elegir a la persona como contacto en una RFP.
model SupplierUserLink {
  id                  String             @id @default(cuid())
  clientId            String
  client              Client             @relation(fields: [clientId], references: [id])
  supplierUserId      String
  supplierUser        SupplierUser       @relation(fields: [supplierUserId], references: [id], onDelete: Cascade)
  supplierDirectoryId String
  supplierDirectory   SupplierDirectory  @relation(fields: [supplierDirectoryId], references: [id], onDelete: Cascade)
  status              SupplierLinkStatus @default(SENT)
  isAdmin             Boolean            @default(false) // administrador de este proveedor: aprueba contactos y gestiona los de su empresa
  inviteToken         String             @unique @default(cuid())
  invitedAt           DateTime           @default(now())
  acceptedAt          DateTime?

  @@unique([supplierUserId, supplierDirectoryId])
}

// Un catálogo con nombre (ej. "RFP-7", o uno creado a mano) que agrupa
// artículos conocidos. Se ofrece crear/usar uno al adjudicar una RFP
// (nombre por defecto = número de RFP, editable), y también se puede
// crear y mantener a mano desde Datos maestros.
model ItemCatalogList {
  id        String             @id @default(cuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id])
  name      String
  createdAt DateTime           @default(now())
  entries   ItemCatalogEntry[]

  @@unique([clientId, name])
}

// Un artículo dentro de un catálogo, con su último precio conocido. La
// llave es (catálogo, código) — el mismo código puede repetirse en
// catálogos distintos. Sirve para seleccionar un artículo ya conocido al
// armar una RFP nueva, trayendo su último precio como histórico; una vez
// elegido, sus datos quedan fijos (no editables) en esa RFP.
model ItemCatalogEntry {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  catalogListId String
  code          String
  name          String
  description   String?
  unit          String
  commodity     String?
  lastPrice     Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  catalogList   ItemCatalogList @relation(fields: [catalogListId], references: [id], onDelete: Cascade)

  @@unique([clientId, catalogListId, code])
}

// Plantilla base: el administrador define artículos/preguntas por defecto
// que se aplican automáticamente a una nueva RFP cuando coincide con las
// condiciones (commodity/región), siempre dentro del mismo Cliente. Cada
// artículo/pregunta puede bloquearse para que solo un rol igual o superior
// a lockMinRole pueda quitarlo.
model RfpTemplate {
  id                               String                  @id @default(cuid())
  clientId                         String
  client                           Client                  @relation(fields: [clientId], references: [id])
  name                             String
  description                      String?
  matchCommodity                   String?
  matchCommodityIncludeDescendants Boolean                 @default(false) // si matchCommodity también aplica a los niveles debajo de él en el árbol
  matchRegion                      String?
  matchRegionIncludeDescendants    Boolean                 @default(false) // idem para matchRegion
  matchPriceCondition              TemplatePriceCondition?
  matchPriceMin                    Float?
  matchPriceMax                    Float?
  active                           Boolean                 @default(true)
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt

  hideResponsesUntilClosed Boolean @default(false) // oculta montos/respuestas al comprador mientras la RFP está Abierta
  minSuppliers             Int? // cantidad mínima de proveedores a invitar para poder publicar una RFP con esta plantilla

  approvalWorkflowId String?
  approvalWorkflow   ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id], onDelete: SetNull)

  items     TemplateItem[]
  questions TemplateQuestion[]
}

// Proceso de aprobación de N niveles por etapa (publicar / adjudicar),
// configurado por el administrador y asignado a una o varias plantillas.
// Cada nivel (ApprovalLevel) se aprueba en secuencia: el nivel N+1 solo
// queda activo cuando el nivel N está aprobado.
model ApprovalWorkflow {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates RfpTemplate[]
  rfps      Rfp[]
  levels    ApprovalLevel[]
}

// Un nivel de aprobación dentro de una etapa (publicar/adjudicar) de un
// proceso. mode determina cómo se resuelve:
// - USERS: cualquiera de los usuarios en userIds
// - GROUP: usuarios del grupo approvalGroupId, evaluados contra el valor
//   de la RFP (según su límite propio para ESE grupo); cumulative
//   determina si basta uno solo (con límite propio suficiente) o si se
//   van sumando límites hasta cubrir el valor.
model ApprovalLevel {
  id         String            @id @default(cuid())
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id])
  workflowId String
  stage      ApprovalStageKind
  order      Int // secuencia dentro de la etapa, empezando en 0

  mode    ApproverMode
  userIds String? // JSON string[], mode = USERS

  approvalGroupId String? // mode = GROUP
  approvalGroup   ApprovalGroup? @relation(fields: [approvalGroupId], references: [id], onDelete: SetNull)
  cumulative      Boolean        @default(false) // solo aplica con mode = GROUP

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model TemplateItem {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  templateId   String
  name         String
  description  String?
  quantity     Float      @default(1)
  unit         String     @default("unidad")
  weight       Int        @default(1)
  decimals     Int        @default(2)
  customFields String?
  section      String? // nombre de la sección a la que pertenece (agrupa y numera)
  order        Int        @default(0)
  lockRoles    UserRole[] // roles que pueden editarlo/quitarlo al crear la RFP; vacío = cualquiera puede

  template RfpTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TemplateQuestion {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  templateId     String
  text           String
  type           QuestionType       @default(TEXT)
  options        String?
  required       Boolean            @default(true)
  weight         Int                @default(1)
  isPrerequisite Boolean            @default(false)
  visibility     QuestionVisibility @default(EXTERNAL)
  respondedBy    QuestionResponder  @default(SUPPLIER)
  numberMin      Float?
  numberMax      Float?
  scoringConfig  String? // JSON: puntaje automático por respuesta (ver src/lib/questionScoring.ts)
  section        String? // nombre de la sección a la que pertenece (agrupa y numera)
  order          Int                @default(0)
  lockRoles      UserRole[] // roles que pueden editarla/quitarla al crear la RFP; vacío = cualquiera puede

  dependsOnQuestionId  String?
  dependsOnHeaderField String?
  dependsOnValue       String?

  template RfpTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Rfp {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  number      Int       @unique // ID visible: "RFP-{number}"; asignado en código vía nextRfpNumber() en lugar de autoincrement()
  title       String
  description String
  buyerName   String
  status      RfpStatus @default(OPEN)
  deadlineAt  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  commodity      String?
  region         String?
  startDate      DateTime?
  estimatedPrice Float?

  origin              String? // opcional, no visible para el proveedor
  predecessorDocument String? // opcional, no visible para el proveedor (texto libre)

  publishedAt              DateTime? // cuándo pasó a OPEN por primera vez
  closedAt                 DateTime? // cuándo se cerró (null si se reabre)
  hideResponsesUntilClosed Boolean   @default(false) // snapshot: alguna plantilla aplicada lo pedía

  basedOnRfpId String? // referencia navegable a la RFP anterior de la que se copió
  basedOnRfp   Rfp?    @relation("RfpLineage", fields: [basedOnRfpId], references: [id], onDelete: SetNull)
  copies       Rfp[]   @relation("RfpLineage")

  roundNumber  Int     @default(1) // 1 = primera ronda; N+1 al "crear como siguiente ronda"
  seriesRootId String? // apunta a la ronda 1 de la serie (null si esta RFP es la ronda 1)
  seriesRoot   Rfp?    @relation("RfpSeries", fields: [seriesRootId], references: [id], onDelete: SetNull)
  seriesRounds Rfp[]   @relation("RfpSeries")

  scoringEnabled Boolean @default(true) // si se activó ponderación de artículos o preguntas al crearla

  awardCriteria            String?
  priceWeightPct           Int?
  awardedInvitationId      String?
  awardedAt                DateTime?
  pendingAwardInvitationId String? // adjudicación propuesta, pendiente de aprobación

  approvalWorkflowId String?
  approvalWorkflow   ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id], onDelete: SetNull)

  appliedTemplates String? // JSON-encoded {id, name}[] snapshot de las plantillas aplicadas al crearla

  // Cuál de las plantillas CON condición (commodity/región/precio) que
  // coinciden fue la elegida — las plantillas sin condiciones (aplican a
  // cualquier RFP) no pasan por esta elección, se aplican siempre además.
  selectedTemplateId String?

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id])

  items           RfpItem[]
  questions       RfpQuestion[]
  invitations     Invitation[]
  approvals       RfpApproval[]
  purchaseRequest PurchaseRequest?
}

// Snapshot en vivo de un nivel de aprobación para una RFP concreta: se crea
// una fila por nivel al disparar la etapa (publicar/adjudicar), congelando
// la config del nivel (mode/userIds/approvalGroupId/cumulative) y el valor
// de la RFP evaluado en ese momento, para que editar el proceso más tarde
// no cambie el requisito de una RFP en curso.
model RfpApproval {
  id       String            @id @default(cuid())
  clientId String
  client   Client            @relation(fields: [clientId], references: [id])
  rfpId    String
  stage    ApprovalStageKind
  order    Int

  mode            ApproverMode
  userIds         String? // JSON string[]
  approvalGroupId String?
  cumulative      Boolean      @default(false)
  requiredValue   Float

  status         RfpApprovalStatus @default(PENDING)
  rejectedReason String?
  createdAt      DateTime          @default(now())
  activatedAt    DateTime? // cuándo este nivel específico pasó a ser el activo (null si aún no le toca)
  lastReminderAt DateTime? // último "enviar recordatorio" registrado

  rfp       Rfp                   @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  decisions RfpApprovalDecision[]

  @@unique([rfpId, stage, order])
}

model RfpApprovalDecision {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  approvalId String
  userId     String
  decision   String // APPROVED | REJECTED
  reason     String?
  decidedAt  DateTime @default(now())

  approval RfpApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])
}

model RfpItem {
  id                       String  @id @default(cuid())
  clientId                 String
  client                   Client  @relation(fields: [clientId], references: [id])
  rfpId                    String
  code                     String? // código de artículo (visible para el proveedor)
  name                     String
  description              String?
  quantity                 Float
  unit                     String
  order                    Int     @default(0)
  weight                   Int     @default(1) // importancia relativa al puntuar (1-10)
  decimals                 Int     @default(2) // precisión decimal para el precio unitario
  historicalPrice          Float? // precio histórico de referencia (no visible para el proveedor)
  commodity                String? // commodity específico de esta línea (no visible para el proveedor)
  customFields             String? // JSON-encoded {label, value}[]
  section                  String? // nombre de la sección a la que pertenece (agrupa y numera)
  sourceTemplateItemId     String? // de qué TemplateItem vino (si aplica)
  locked                   Boolean @default(false) // si venía bloqueado por la plantilla
  sourceItemCatalogEntryId String? // de qué ItemCatalogEntry vino (si aplica) — sus datos quedan fijos, sin excepción de rol

  rfp        Rfp         @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  itemPrices ItemPrice[]
}

model RfpQuestion {
  id       String       @id @default(cuid())
  clientId String
  client   Client       @relation(fields: [clientId], references: [id])
  rfpId    String
  text     String
  type     QuestionType @default(TEXT)
  options  String? // JSON-encoded string[] for SELECT type
  required Boolean      @default(true)
  weight   Int          @default(1) // importancia relativa al puntuar (1-10)
  order    Int          @default(0)

  isPrerequisite   Boolean            @default(false) // el proveedor debe aceptarla para participar
  visibility       QuestionVisibility @default(EXTERNAL)
  respondedBy      QuestionResponder  @default(SUPPLIER)
  buyerAnswerValue String? // respuesta del propio comprador cuando respondedBy = BUYER
  numberMin        Float?
  numberMax        Float?
  scoringConfig    String? // JSON: puntaje automático por respuesta (ver src/lib/questionScoring.ts)

  dependsOnQuestionId  String? // condicionada a la respuesta de otra pregunta
  dependsOnHeaderField String? // o condicionada a un dato de cabecera (commodity, region)
  dependsOnValue       String? // valor requerido para mostrarla

  section String? // nombre de la sección a la que pertenece (agrupa y numera)

  sourceTemplateQuestionId String? // de qué TemplateQuestion vino (si aplica)
  locked                   Boolean @default(false) // si venía bloqueada por la plantilla

  rfp     Rfp      @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Supplier {
  id                  String             @id @default(cuid())
  clientId            String
  client              Client             @relation(fields: [clientId], references: [id])
  name                String
  email               String
  company             String
  supplierDirectoryId String? // seteado cuando se invitó eligiendo desde el directorio (no texto libre)
  supplierDirectory   SupplierDirectory? @relation(fields: [supplierDirectoryId], references: [id], onDelete: SetNull)

  invitations Invitation[]
}

model Invitation {
  id         String           @id @default(cuid())
  clientId   String
  client     Client           @relation(fields: [clientId], references: [id])
  rfpId      String
  supplierId String
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(INVITED)
  invitedAt  DateTime         @default(now())
  viewedAt   DateTime?
  notifiedAt DateTime? // cuándo se envió el correo de invitación (una sola vez por invitación)

  rfp      Rfp       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  response Response?

  @@unique([rfpId, supplierId])
}

model Response {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  invitationId String   @unique
  submittedAt  DateTime @default(now())
  notes        String?

  invitation Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  answers    Answer[]
  itemPrices ItemPrice[]
}

model Answer {
  id         String @id @default(cuid())
  clientId   String
  client     Client @relation(fields: [clientId], references: [id])
  responseId String
  questionId String
  value      String
  score      Int? // puntaje asignado por el comprador (0-10)

  response Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question RfpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model ItemPrice {
  id         String  @id @default(cuid())
  clientId   String
  client     Client  @relation(fields: [clientId], references: [id])
  responseId String
  itemId     String
  unitPrice  Float
  notes      String?

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  item     RfpItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([responseId, itemId])
}

// Texto editable de cada correo, por cliente e idioma. Si no hay fila, se usa
// el texto por defecto del diccionario.
model EmailTemplate {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      String // ver EMAIL_KINDS en src/lib/emailKinds.ts
  language  String // "es" | "en"
  subject   String
  heading   String
  body      String // párrafos separados por salto de línea
  cta       String
  updatedAt DateTime @updatedAt

  @@unique([clientId, kind, language])
}

enum EmailLogStatus {
  SENT
  FAILED
  NOT_SENT // intento registrado pero sin SMTP configurado
}

// Cada correo que la app intentó enviar (enviado, fallido o no enviado por
// falta de SMTP). rfpId no es FK para conservar el registro aunque se borre la RFP.
model EmailLog {
  id        String         @id @default(cuid())
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rfpId     String?
  kind      String
  toEmail   String // destinatario real previsto
  sentTo    String // a dónde se envió de verdad (distinto si hay MAIL_REDIRECT_TO)
  subject   String
  status    EmailLogStatus
  error     String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([clientId, createdAt])
}

// Grupo de compradores al que se puede asignar una solicitud.
model BuyerGroup {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  members  BuyerGroupMember[]
  requests PurchaseRequest[]

  @@unique([clientId, name])
}

model BuyerGroupMember {
  id      String     @id @default(cuid())
  groupId String
  userId  String
  group   BuyerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// Cómo leer un Excel de solicitudes (qué pestañas y columnas). Los mapeos
// guardan nombres de columna del Excel.
model RequestImportTemplate {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  importMode    String   @default("MASS") // "MASS": varias solicitudes por archivo (líneas enlazadas por n.º de documento); "SINGLE": un archivo por solicitud
  headerSheet   String // pestaña con las cabeceras de las solicitudes
  linesSheet    String // pestaña con las líneas
  headerMapping Json // campo de la solicitud -> columna del Excel
  linesMapping  Json // campo de la línea -> columna del Excel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests PurchaseRequest[]

  @@unique([clientId, name])
}

// Solicitud de compra (PR) importada. Su estado (Nuevo, Procesado, En
// negociación, Negociado) se deriva de la RFP vinculada; solo "cancelada" se guarda.
model PurchaseRequest {
  id               String                 @id @default(cuid())
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType     String
  documentNumber   String
  creator          String? // quién la creó en el sistema de origen
  requestDate      DateTime? // fecha de la solicitud (solo fecha, guardada a medianoche UTC)
  commodity        String? // grupo de artículos
  importedAt       DateTime               @default(now())
  importedByUserId String?
  importedBy       User?                  @relation("RequestImporter", fields: [importedByUserId], references: [id], onDelete: SetNull)
  templateId       String?
  template         RequestImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedUserId   String?
  assignedUser     User?                  @relation("RequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedGroupId  String?
  assignedGroup    BuyerGroup?            @relation(fields: [assignedGroupId], references: [id], onDelete: SetNull)
  cancelled        Boolean                @default(false)
  rfpId            String?                @unique
  rfp              Rfp?                   @relation(fields: [rfpId], references: [id], onDelete: SetNull)

  lines PurchaseRequestLine[]

  @@unique([clientId, documentType, documentNumber])
  @@index([clientId, importedAt])
}

model PurchaseRequestLine {
  id              String          @id @default(cuid())
  requestId       String
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order           Int
  position        String
  itemCode        String?
  description     String
  historicalPrice Float?
  quantity        Float
  unit            String?
  commodity       String?

  @@index([requestId])
}

// Cómo se llena una RFP nueva a partir de una solicitud ya cargada. Es una
// configuración por cliente (no depende de la plantilla de importación): mapea
// campos de la tabla de solicitudes a campos de la RFP.
model RequestRfpMapping {
  id        String   @id @default(cuid())
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mapping   Json
  updatedAt DateTime @updatedAt
}

// Preferencias de interfaz guardadas por usuario (disposición de columnas,
// agrupación y filtros de las listas). userId es el id de un User o de un
// SupplierUser (cuids, no colisionan), por eso no hay relación.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}
